# Copy to .env and fill in. Never commit the real file.

# PostgreSQL password used by docker-compose.
POSTGRES_PASSWORD=change-me

# Signing key of the access tokens: at least 32 random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Groq API key (https://console.groq.com) for the AI summary of an analysis.
# The API refuses to start without a value.
GROQ_API_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60
